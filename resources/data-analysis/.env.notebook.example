# Vault KV v2 (default). Supply a token with read access to this secret.
VAULT_ADDR=
VAULT_TOKEN=
VAULT_KV_MOUNT=kv
VAULT_SECRET_PATH=f5.news

# Direct database credentials (set CREDENTIAL_SOURCE = "env").
# Copy these keys to the repository root's ignored .env.
# Use a read-only database account. URL-encode the password in the URI.
mongo_uri=mongodb+srv://<USER>:<URL_ENCODED_PASSWORD>@<CLUSTER_HOST>/?authSource=admin
database=f5-news-db
collection=newposts
